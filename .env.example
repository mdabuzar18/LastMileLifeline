# LastMile Lifeline - Environment Configuration Template
# COPY THIS FILE TO .env FOR LOCAL OVERRIDES.
# NOTICE: NEVER STORE PRODUCTION CREDENTIALS OR REAL SECRETS IN THIS FILE.

# Application Environment
ENVIRONMENT=development
DEBUG=true

# Security Key (Demo only - replace with strong random string in staging/production)
SECRET_KEY=demo-insecure-secret-key-lastmile-lifeline-2026

# Database Configuration
# Local SQLite default: sqlite:///./lastmile_lifeline.db
# Docker Compose PostgreSQL: postgresql://lastmile_user:lastmile_demo_password@localhost:5432/lastmile_db
DATABASE_URL=sqlite:///./lastmile_lifeline.db

# Redis Message Queue Configuration
# Local Redis: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# Worker and Retry Settings
WORKER_QUEUE_NAME=lastmile:simulated_notifications
MAX_NOTIFICATION_RETRIES=3
RETRY_DELAY_SECONDS=2

# Simulated Network Glitch Rate (0.0 to 1.0)
SIMULATE_FAILURE_RATE=0.0
